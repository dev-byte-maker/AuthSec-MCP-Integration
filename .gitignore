*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/

# ---- Virtual environments ----
.venv/
venv/
ENV/
env/
.envrc

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# ---- Packaging / builds ----
build/
dist/
*.egg-info/
*.egg
MANIFEST

